# Dependencies. server.js has ZERO runtime deps and runs without them; the only deps are dev-only
# (typescript + @types/node for the // @ts-check type-check) and are NOT shipped. node_modules stays
# out of git – but package-lock.json IS committed, damit die CI mit `npm ci` die gepinnte Dev-Toolchain
# reproduzierbar installiert (Typecheck-Gate). `npm ci` scheitert ohne committetes Lockfile.
node_modules

# Runtime/logs
*.log
.DS_Store

# Local configuration/environment
.env
*.local

# User's WireGuard client config (contains the PRIVATE KEY!) - NEVER commit
/wireguard/
*.conf
