# Copy to .env and adjust (or set the values in docker-compose.yml / systemd).

# Port the relay listens on.
PORT=8787

# Name of the VPN interface (setting it explicitly is recommended -> unambiguous fail-closed). E.g. wg0, tun0.
RELAY_VPN_IF=wg0

# Access protection:  open (default) | ip | basic
RELAY_AUTH=open
#   ip:    allowed client IPs (comma-separated list)
# RELAY_ALLOW=1.2.3.4,5.6.7.8
#   basic: user/password
# RELAY_USER=phantom
# RELAY_PASS=change-me

# Privacy: OFF by default (no ipwho.is call). Set to 1 to show the relay's exit IP in /health.
# RELAY_EGRESS_LOOKUP=1
