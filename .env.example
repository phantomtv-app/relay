# Copy to .env and adjust (or set the values in docker-compose.yml / systemd).

# Port the relay listens on.
PORT=8787

# Name of the VPN interface (setting it explicitly is recommended -> unambiguous fail-closed). E.g. wg0, tun0.
RELAY_VPN_IF=wg0

# Fail-closed: without an ACTIVE VPN interface the relay blocks /p entirely. For local development
# WITHOUT a VPN, opt out (forwards UNPROTECTED - never in production):
# RELAY_ALLOW_UNPROTECTED=1

# Access protection (REQUIRED):  ip | basic | open
# There is NO default: if RELAY_AUTH is unset (or invalid) the relay DENIES /p (fail-closed, safe).
# Recommended: basic with a STRONG random secret.
RELAY_AUTH=basic
RELAY_USER=phantom
# ACHTUNG: 'change-me' ist ein bekannter Platzhalter. Der Server LEHNT diesen Wert ab und bleibt
# fail-closed (blockiert /p komplett), bis du hier ein ECHTES, zufälliges Passwort setzt. So kann
# ein kopiertes .env.example nie mit öffentlich bekannten Zugangsdaten online gehen. Der Installer
# (install.sh) erzeugt beim ersten Lauf automatisch ein sicheres Zufallspasswort.
RELAY_PASS=change-me
#   ip mode: only these client IPs may use /p
# RELAY_AUTH=ip
# RELAY_ALLOW=1.2.3.4,5.6.7.8
#   open mode: no access control at all - ONLY on a trusted LAN (explicit opt-in)
# RELAY_AUTH=open

# Egress display in /health: DEFAULT OFF (no periodic outbound call). OPT-IN with =1 to let the relay
# look up its OWN exit IP THROUGH the tunnel via phantom_'s endpoint (RELAY_EGRESS_URL, default
# https://phantomtv.app/api/my-ip - no third party, no user data) so the app can show the IP comparison
# and the RELAY_REAL_IP leak veto becomes possible. The 'protected' attest does NOT need this.
# RELAY_EGRESS_LOOKUP=1

# HLS rewrite base. Behind a reverse proxy set the fixed public URL so segment/key URLs are rewritten
# correctly and cannot be forged via a spoofed Host header. Without it the Host header is used.
# RELAY_PUBLIC_URL=https://relay.example
# Only these proxy IPs may set X-Forwarded-Proto/-Host (comma list). Empty = trust none.
# RELAY_TRUSTED_PROXIES=

# CORS: Access-Control-Allow-Origin for responses. Default * (the app runs under file://). Narrow it
# if all your clients share a known origin.
# RELAY_CORS_ORIGIN=*

# OPTIONAL egress leak veto: your host's REAL (non-VPN) public IP. If the measured egress equals it,
# the tunnel is not effective -> /health honestly reports vpn:false. This only ADDS a check on top of
# the routing-proof attest and requires RELAY_EGRESS_LOOKUP=1 to have any effect.
# RELAY_REAL_IP=

# Resource limits (DoS hardening). Defaults shown; 0 disables the concurrency/rate caps.
# RELAY_MAX_CONCURRENT=128       global in-flight /p requests
# RELAY_RATE_MAX=600             per-client /p requests per window
# RELAY_RATE_WINDOW_MS=60000
# RELAY_IDLE_TIMEOUT_MS=30000    abort an upstream that stops sending data
# RELAY_MAX_STREAM_MS=0          hard per-stream cap (keep 0 for long live streams)
